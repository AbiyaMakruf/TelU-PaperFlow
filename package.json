{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.9.0",
    "scripts": {
        "build": "vite build",
        "dev": "concurrently -k -n \"SERVE,QUEUE,VITE\" -c \"blue,magenta,yellow\" \"php artisan serve\" \"php artisan queue:work --tries=3\" \"vite\"",
        "dev:ngrok": "concurrently -k -n \"SERVE,QUEUE,VITE,NGROK\" -c \"blue,magenta,yellow,cyan\" \"php artisan serve\" \"php artisan queue:work --tries=3\" \"vite\" \"ngrok http --url=hormonal-shari-noncommodiously.ngrok-free.dev 8000\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.15.12",
        "alpinejs": "^3.15.12"
    }
}
